# DATSerp ERP Credentials
ERP_USERNAME=your_erp_username@sng.com
ERP_PASSWORD=your_erp_password

# Cloud Database URL (Supabase PostgreSQL used by Render)
DATABASE_URL=postgresql://user:pass@host:6543/postgres

# Local Download Directory (Defaults to ./downloads/<today_date>)
DOWNLOAD_DIR=

# Browser Automation: true (silent background) or false (visible Chrome window)
HEADLESS=false
