# Srinithi Garment ERP - Environment Configuration Template
# Copy this file to .env and configure your production values.

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://username:password@host:port/dbname

# Flask Secret Key for Session Encryption (Generate a secure random string in production)
SECRET_KEY=change-this-in-production-to-a-secure-random-string

# Server Host & Port
HOST=127.0.0.1
PORT=5050

# Flask Debug Mode (Set to False for production)
FLASK_DEBUG=False

# Cookie Security (Set to True if serving over HTTPS / SSL)
COOKIE_SECURE=False

# Optional AI Assistant Key (OpenRouter)
OPENROUTER_API_KEY=
