# Srinithi Garment ERP - Environment Configuration Template
# Copy this file to .env and configure your production values.

# Database Connection (PostgreSQL connection string)
DATABASE_URL=

# Flask Secret Key
SECRET_KEY=

# Server Host & Port
HOST=0.0.0.0
PORT=5050

# Flask Debug Mode
FLASK_DEBUG=False

# Cookie Security (Set to True if serving over HTTPS)
COOKIE_SECURE=False

# Optional AI Assistant Key (OpenRouter)
OPENROUTER_API_KEY=
